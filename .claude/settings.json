{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git --version)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git branch:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git push:*)",
      "Bash(npm ci:*)",
      "Bash(npm install:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)",
      "Bash(npm run verify)",
      "Bash(npm run probar-migraciones)",
      "Bash(npx eslint:*)",
      "Bash(npx tsc:*)",
      "Bash(node:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "mcp__github__search_issues",
      "mcp__github__issue_read",
      "mcp__github__issue_write",
      "mcp__github__add_issue_comment",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__pull_request_read",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__okhub__buscar",
      "mcp__okhub__esquema",
      "mcp__okhub__cliente_detalle",
      "mcp__okhub__trabajos_listar",
      "mcp__okhub__trabajo_detalle",
      "mcp__okhub__tickets_listar",
      "mcp__okhub__tareas_app_listar",
      "mcp__okhub__agenda_dia",
      "mcp__okhub__presupuestos_listar",
      "mcp__okhub__proyectos_listar",
      "mcp__okhub__proyecto_detalle",
      "mcp__okhub__proyecto_pagina_leer",
      "mcp__okhub__equipo",
      "mcp__okhub__sync_estado",
      "mcp__okhub__claude_peticiones_pendientes",
      "mcp__okhub__claude_peticion_tomar",
      "mcp__okhub__claude_peticion_terminar",
      "mcp__okhub__proyecto_crear",
      "mcp__okhub__proyecto_actualizar",
      "mcp__okhub__proyecto_objetivo_crear",
      "mcp__okhub__proyecto_objetivo_actualizar",
      "mcp__okhub__proyecto_hito_crear",
      "mcp__okhub__proyecto_hito_actualizar",
      "mcp__okhub__proyecto_tarea_crear",
      "mcp__okhub__proyecto_tarea_actualizar",
      "mcp__okhub__proyecto_pagina_crear",
      "mcp__okhub__proyecto_pagina_actualizar",
      "mcp__okhub__proyecto_vincular",
      "WebSearch",
      "WebFetch"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)"
    ]
  },
  "enableAllProjectMcpServers": true
}
